#!/usr/bin/env bash
# Start the bridge under supervisord if it is not running. Quiet when all is fine.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || { echo "tg-bridge: dependencies are not installed; run $DIR/bin/tg-install" >&2; exit 2; }
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m tgbridge.ctl ensure
