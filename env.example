# Copy to ~/.config/tg-bridge/env and protect it:
#   mkdir -p ~/.config/tg-bridge && chmod 700 ~/.config/tg-bridge
#   cp env.example ~/.config/tg-bridge/env && chmod 600 ~/.config/tg-bridge/env
# The bridge refuses to start if this file is readable by anyone but you.
#
# This file is authoritative: process environment variables only fill in
# settings that are NOT set here (the box is shared; generic names like
# ROUTINE_KEY may belong to someone else).

# Your numeric Telegram user id (the owner; always allowed)
TG_OWNER_ID=
# Optional extra numeric Telegram user ids (comma-separated) who may also
# talk to the bot in their own private chat. They must press Start first.
# TG_ALLOWED_USER_IDS=
# From the Grok Bot webhook routine
ROUTINE_URL=

# --- Secrets: pick ONE source per secret ------------------------------------
# a) Name the environment variable that holds it (recommended when the secret
#    is provided as a box/env secret). Only that variable is read:
# TG_BOT_TOKEN_ENV=TG_BOT_TOKEN
# ROUTINE_KEY_ENV=TGGROK_ROUTINE_KEY
# b) Or write the value here (this file is chmod 600):
# TG_BOT_TOKEN=          # from @BotFather (/newbot), looks like 123456789:AA...
# ROUTINE_KEY=           # the key shown for the webhook routine
# Setting both NAME and NAME_ENV is a config error. With neither, the generic
# env variable NAME is used (legacy).

# Optional
# TG_PLACEHOLDER=🗨️ Думаю...  # v4.3: placeholder reply that tg-send turns into the answer; off = none
# TG_PLACEHOLDER_EDIT_MAX_AGE=0  # seconds; older placeholders are deleted and the answer is sent
#                                # as a new message (so Telegram notifies). 0 = always edit
# TG_STICKER_PACK=VikostVSpack  # v4.4: thinking sticker after «🗨️ Думаю...»; off — выключить
# TG_REACTION=off           # v4.3: off by default; set e.g. 👀 to also react to incoming messages
# TG_MAX_WAKES_PER_MIN=12   # protects routine limits (200 runs/hour per routine)
# TG_MAX_FILE_MB=20         # Telegram Bot API download limit is 20 MB
# TG_INBOX_KEEP_DAYS=7
# TG_TYPING_MAX_SECONDS=120
# TG_DELIVERY_ATTEMPTS=6    # webhook attempts for transient errors, then deadletter/
# TG_WATCHDOG_SECONDS=180   # no progress this long = hung -> restart (90..3600)
# TG_HISTORY_MESSAGES=20    # prior messages of the same chat+topic put into the webhook `history` (0 = off)
# TG_HISTORY_MAX_CHARS=12000 # character budget for `history`
# TG_HISTORY_DAYS=7          # retention of stored conversations

# v4 (Telegram Serverless): the tgcloud CLI reads its access token from the
# TGCLOUD_TOKEN environment variable (@BotFather → bot → Serverless → CLI Access).
# Do not write it here; bin/tg-cloud setup copies ROUTINE_URL, the routine key,
# TG_OWNER_ID, TG_ALLOWED_USER_IDS and the TG_HISTORY_* limits to Serverless.

# xAI Management API (for the /usage card)
# bin/xai-usage reads these from the process environment (a box secret),
# not from this file. Do not paste the key here.
# XAI_MANAGEMENT_KEY=          # Management key from Console → Settings → Management Keys
# XAI_TEAM_ID=<TEAM_ID>        # or the local file xai-team-id (not committed); see xai-team-id.example

